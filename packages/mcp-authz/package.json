{
  "name": "mcp-authz",
  "version": "0.5.0",
  "description": "Authorization for MCP servers: OAuth 2.1 resource server, roles/permissions policy, permission-gated tools (2026-07-28)",
  "repository": {
    "type": "git",
    "url": "https://github.com/jagreehal/mcp-authz",
    "directory": "packages/mcp-authz"
  },
  "homepage": "https://github.com/jagreehal/mcp-authz#readme",
  "bugs": {
    "url": "https://github.com/jagreehal/mcp-authz/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "import": "./dist/proxy.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "import": "./dist/openapi.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --coverage && prettier --write docs/stories.md",
    "test:watch": "vitest",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "oauth",
    "authorization",
    "resource-server",
    "rbac",
    "openapi"
  ],
  "author": "Jag Reehal <jag@jagreehal.com> (https://jagreehal.com)",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.0",
    "@modelcontextprotocol/server": "^2.3.0",
    "awaitly": "6.2.0",
    "cross-spawn": "^7.0.6",
    "jose": "^6.2.12"
  },
  "peerDependencies": {
    "@modelcontextprotocol/node": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "ajv": "^8.20.0",
    "executable-stories-vitest": "8.10.1",
    "tsdown": "^0.23.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "mcp-authz": "./dist/cli.js"
  }
}
