{
  "name": "mcp-authz-helpscout-example",
  "version": "0.1.0",
  "private": true,
  "description": "Help Scout MCP server for an org agent: your tools, mcp-authz policy, static bearer inbound",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsx watch src/node.ts",
    "start": "node dist/node.js",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "mcp-authz": "workspace:*",
