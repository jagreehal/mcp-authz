{
  "name": "mcp-authz-node-example",
  "version": "0.1.0",
  "private": true,
  "description": "Example remote MCP server using mcp-authz",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "MCP_DEV_AUTH=1 tsx watch src/node.ts",
    "start": "node dist/node.js",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "token": "MCP_DEV_AUTH=1 tsx src/token.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "autotel": "^9.0.0",
    "autotel-mcp-instrumentation": "^60.0.0",
    "jose": "^6.2.12",
    "mcp-authz": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "tsdown": "^0.23.5",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
