MCP_PUBLIC_URL=https://mcp.acme.com/mcp
PORT=8200

OAUTH_ISSUER=https://auth.acme.com
OAUTH_AUTHORIZATION_ENDPOINT=https://auth.acme.com/authorize
OAUTH_TOKEN_ENDPOINT=https://auth.acme.com/token
OAUTH_REGISTRATION_ENDPOINT=https://auth.acme.com/register
OAUTH_JWKS_URI=https://auth.acme.com/jwks

# Optional: refuse tokens from outside this Google Workspace domain
# GOOGLE_WORKSPACE_DOMAIN=acme.com

# Optional: the whole policy as JSON, instead of the typed one in src/policy.ts
# MCP_POLICY={"roles":{"reader":["cases:read"],"editor":["cases:read","cases:write"]},"rules":[{"match":{"domain":"acme.com"},"role":"reader"},{"match":{"email":"alice@acme.com"},"role":"editor"}]}
